<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.chapter05.mapper.Chapter05SkillMapper">
    <resultMap id="skillWithEmployeesMap" type="com.example.chapter05.entity.Skill">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <collection property="emps" ofType="com.example.chapter05.entity.Emp">
            <id property="empno" column="empno"/>
            <result property="ename" column="ename"/>
            <result property="job" column="job"/>
            <result property="mgr" column="mgr"/>
            <result property="hiredate" column="hiredate"/>
            <result property="sal" column="sal"/>
            <result property="comm" column="comm"/>
            <result property="deptno" column="deptno"/>
        </collection>
    </resultMap>

    <select id="findByIdWithEmployeesByXml" parameterType="java.lang.Integer" resultMap="skillWithEmployeesMap">
        SELECT s.id, s.name, s.description,
               e.empno, e.ename, e.job, e.mgr, e.hiredate, e.sal, e.comm, e.deptno
        FROM skill s
        LEFT JOIN emp_skill es ON es.skill_id = s.id
        LEFT JOIN emp e ON e.empno = es.empno
        WHERE s.id = #{skillId}
        ORDER BY e.empno
    </select>
</mapper>
